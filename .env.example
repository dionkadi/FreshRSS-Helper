# 自定义订阅助手 (Subscription Helper) 环境变量示例
# 使用方式：复制本文件为 .env 并填入真实值，然后 docker compose up -d

# FreshRSS 基础地址（容器内部署时通常为 http://freshrss）
FRESHRSS_BASE_URL=http://freshrss

# FreshRSS 用户名
FRESHRSS_USER=

# FreshRSS API 密码
# 注意：这是 API 密码（API password），不是登录密码。
# 需在 FreshRSS 设置 -> 账户 -> API 管理 中开启并单独设置。
FRESHRSS_API_PASSWORD=

# RSSHub 基础地址（RSSHub 容器内部地址）
RSSHUB_BASE_URL=http://rsshub:1200

# 服务监听端口
PORT=8081
